<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Barangay_E_Service_System</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="SERVICES\" />
    <Folder Include="MODELS\" />
    <Folder Include="REPOSITORIES\" />
    <Folder Include="USERCONTROLS\Admin\" />
    <Folder Include="USERCONTROLS\Shared\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="USERCONTROLS\Resident\Forgot Password and Change\ForgotPasswordControl.Designer.cs">
      <DependentUpon>ForgotPasswordControl.cs</DependentUpon>
    </Compile>
    <Compile Update="USERCONTROLS\Resident\Forgot Password and Change\ChangePasswordControl.Designer.cs">
      <DependentUpon>ChangePasswordControl.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="USERCONTROLS\Resident\Forgot Password and Change\ForgotPasswordControl.resx">
      <DependentUpon>ForgotPasswordControl.cs</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Update="USERCONTROLS\Resident\Forgot Password and Change\ChangePasswordControl.resx">
      <DependentUpon>ChangePasswordControl.cs</DependentUpon>
    </EmbeddedResource>
    <Compile Update="USERCONTROLS\Resident\Profile\ResidentProfileControl.Designer.cs">
      <DependentUpon>ResidentProfileControl.cs</DependentUpon>
    </Compile>
    <Compile Update="USERCONTROLS\Resident\Profile\ResidentEditProfileControl.Designer.cs">
      <DependentUpon>ResidentEditProfileControl.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="USERCONTROLS\Resident\Profile\ResidentProfileControl.resx">
      <DependentUpon>ResidentProfileControl.cs</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Guna.UI2.WinForms" Version="2.0.4.8" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>

</Project>
